{
  "name": "reservo",
  "version": "1.1.0",
  "description": "Lightweight appointment management library for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./transports/smtp": {
      "types": "./dist/transports/smtp.d.ts",
      "require": "./dist/transports/smtp.js",
      "import": "./dist/transports/smtp.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "test:coverage": "tsc -p tsconfig.coverage.json && c8 --all --src .cov --include \".cov/**/*.js\" --exclude \".cov/**/*.test.js\" --exclude \"**/types.ts\" --exclude \".cov/**/types.js\" --check-coverage --lines 100 --functions 100 --branches 100 --statements 100 --reporter=text --reporter=lcov node --test \".cov/**/*.test.js\"; code=$?; rm -rf .cov; exit $code",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "appointment",
    "scheduling",
    "booking",
    "calendar",
    "reservation"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "c8": "^12.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "nodemailer": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  }
}
